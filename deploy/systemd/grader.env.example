# Install as /etc/convexpi/grader.env, owned by root with mode 0600.
# Keep actual secrets outside the repository. These values are placeholders.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
MARKET_SEED=REPLACE_WITH_PRIVATE_INTEGER
SANDBOX_TMPDIR=/var/lib/convexpi-sandbox
GRADER_DOCKER_IMAGE=convexpi-sandbox:local
MARKET_N_STOCKS=200
MARKET_N_DAYS=1260
GRADE_TIMEOUT=60
MAX_SUBMISSIONS_PER_RUN=20
