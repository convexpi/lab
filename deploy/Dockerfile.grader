FROM python:3.12-slim

# This is the trusted coordinator. Language runtimes belong in Dockerfile.sandbox;
# the coordinator only needs the Docker client and the Python scoring libraries.
RUN apt-get update \
    && apt-get install -y --no-install-recommends docker-cli ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ src/
COPY deploy/ deploy/
RUN pip install --no-cache-dir .

# Hosted execution requires a reachable Docker daemon and a prebuilt, credential-free
# GRADER_DOCKER_IMAGE. There is deliberately no host-process fallback.

# Required env vars (set on the dedicated host):
#   NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_KEY, MARKET_SEED
# Optional:
#   MARKET_N_STOCKS, MARKET_N_DAYS, GRADE_TIMEOUT, MAX_SUBMISSIONS_PER_RUN
#   GRADER_DOCKER_IMAGE  — REQUIRED for grading (build deploy/Dockerfile.sandbox)
#   SENTRY_DSN           — set to enable Sentry error monitoring

CMD ["python", "deploy/grader_worker.py", "--once"]
